DATABASE_URL=postgres://user:pass@host/db?sslmode=require
BLOB_READ_WRITE_TOKEN=
# REQUIRED. Must be a long random string (e.g. openssl rand -hex 32). App will refuse to start if unset.
JWT_SECRET=
VITE_APP_URL=http://localhost:5173

# Comma-separated list of emails auto-promoted to admin on register/login.
# Useful to bootstrap the first admin without SQL access.
ADMIN_EMAIL=

# Email (Resend). Unset = log-only no-op.
RESEND_API_KEY=
EMAIL_FROM="Daily Planner <onboarding@resend.dev>"
