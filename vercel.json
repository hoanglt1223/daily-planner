{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/tasks/:id", "destination": "/api/tasks?id=:id" },
    { "source": "/api/categories/:id", "destination": "/api/categories?id=:id" },
    { "source": "/api/tasks/:id/:action", "destination": "/api/tasks?id=:id&action=:action" },
    { "source": "/api/time-blocks/:id", "destination": "/api/time-blocks?id=:id" },
    { "source": "/api/reports/:kind", "destination": "/api/reports?kind=:kind" },
    { "source": "/api/admin/:action", "destination": "/api/admin?action=:action" },
    { "source": "/api/share/:token", "destination": "/api/share?token=:token" },
    { "source": "/api/bookings/:action", "destination": "/api/bookings?action=:action" },
    { "source": "/api/bookings/:action/:id", "destination": "/api/bookings?action=:action&id=:id" },
    { "source": "/api/goals/:id", "destination": "/api/goals?id=:id" },
    { "source": "/api/goals/:id/:action", "destination": "/api/goals?id=:id&action=:action" },
    { "source": "/api/music/:id", "destination": "/api/music?id=:id" },
    { "source": "/api/music/:id/:action", "destination": "/api/music?id=:id&action=:action" },
    { "source": "/api/task-sessions/:id", "destination": "/api/task-sessions?id=:id" },
    { "source": "/api/task-sessions/:id/:action", "destination": "/api/task-sessions?id=:id&action=:action" },
    { "source": "/api/weddings/:id", "destination": "/api/weddings?id=:id" },
    { "source": "/api/weddings/:id/:action", "destination": "/api/weddings?id=:id&action=:action" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
